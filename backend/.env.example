# Backend environment configuration (placeholders only - do not commit real secrets)
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-publishable-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key-optional>
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret-optional>

# AI Provider (Groq is the live System-2 provider; mock is tests only)
LLM_PROVIDER=groq

GROQ_MODEL=llama-3.3-70b-versatile
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:3b

# Application settings
APP_NAME=Self-Evolving CRM
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
